public class StackArray {
    int[] stack = new int[5];
    int top = -1;

    void push(int x) {
        if (top == stack.length - 1) return;
        stack[++top] = x;
    }

    void pop() {
        if (top == -1) return;
        top--;
    }

    int peek() {
        if (top == -1) return -1;
        return stack[top];
    }

    public static void main(String[] args) {
        StackArray s = new StackArray();
        s.push(10);
        s.push(20);
        System.out.println(s.peek());
    }
}
